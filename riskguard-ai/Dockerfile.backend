FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend backend
COPY ml ml
COPY scripts scripts

EXPOSE 8000
WORKDIR /workspace/backend

# Seed the held-out demo stream on first boot (only when the DB is empty), then
# serve. DATABASE_URL and the ml/ package resolve against /workspace the same
# way they do in local development.
CMD ["sh", "-c", "python /workspace/scripts/docker_entrypoint.py && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]