DATABASE_URL=sqlite:///./riskguard.db
# Production-style deployment (PostgreSQL): 
# DATABASE_URL=postgresql+psycopg2://riskguard:secret@host:5432/riskguard
#   -> pip install -r backend/requirements-postgres.txt
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production
# Optional per-role password overrides (default demo passwords documented in
# README: RiskGuard@riskadmin / RiskGuard@riskanalyst / RiskGuard@riskviewer)
RISK_ADMIN_PASSWORD=
RISK_ANALYST_PASSWORD=
RISK_VIEWER_PASSWORD=
FP_COST_PER_INCIDENT=50.0
FN_COST_PER_INCIDENT=500.0
# HITL decision bands (single source of truth in backend/app/risk_policy.py):
# [0, 25) AI_AUTOPILOT | [25, 90) HUMAN_REVIEW | [90, 100] AI_MANAGED_BLOCK
RISK_BAND_AUTOPILOT_MAX=25
RISK_BAND_BLOCK_MIN=90
